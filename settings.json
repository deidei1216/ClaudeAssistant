{
  "defaults": {
    "model": "sonnet",
    "permissionMode": "auto"
  },
  "limits": {
    "maxConcurrentSessions": 10,
    "sessionTimeout": 3600000,
    "maxTriggersPerSession": 50
  },
  "enabledAdapters": [
    "weixin"
  ],
  "logging": {
    "level": "info",
    "file": "logs/gateway.log"
  },
  "aggregation": {
    "quietWindowMs": 5000,
    "maxWindowMs": 30000
  }
}
